# PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key for JWT signing – generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-string-at-least-32-chars

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
